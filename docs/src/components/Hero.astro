---
// The landing page hero: the pitch and actions from the page's `hero`
// frontmatter, then the captured hero screenshot in light and dark.
import { LinkButton } from "@astrojs/starlight/components";
import { darkTwin, screenshotSize } from "../screenshots.mjs";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const shot = "/screenshots/hero.webp";
const size = await screenshotSize(shot);
const alt =
	"Obsidian with an episode note open, its captured timestamp links, and the PodNotes player in the sidebar playing the episode";
---

<div class="hero">
	<div class="copy">
		<p class="eyebrow">A podcast player for Obsidian</p>
		<h1 id="_top" data-page-title>
			{data.legacyTitleId && <span id={data.legacyTitleId} />}
			<Fragment set:html={title} />
		</h1>
		{tagline && <p class="tagline" set:html={tagline} />}
		<div class="actions">
			{
				actions.map(({ attrs, icon, link: href, text, variant }) => (
					<LinkButton {href} {variant} icon={icon?.name} {...attrs}>
						{text}
					</LinkButton>
				))
			}
		</div>
	</div>
	<div class="shot">
		<img src={shot} {alt} {...size} class="dark:sl-hidden" fetchpriority="high" />
		<img src={darkTwin(shot)} {alt} {...size} class="light:sl-hidden" fetchpriority="high" />
	</div>
</div>

<style>
	@layer starlight.core {
		.hero {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: clamp(2rem, 5vw, 3.5rem);
			padding-block: clamp(2rem, 6vw, 4.5rem) 1rem;
			text-align: center;
		}
		.copy {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1rem;
			max-width: 46rem;
		}
		.eyebrow {
			font-size: var(--sl-text-sm);
			font-weight: 600;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--sl-color-text-accent);
		}
		h1 {
			font-size: clamp(var(--sl-text-3xl), calc(1rem + 4vw), var(--sl-text-6xl));
			line-height: 1.1;
			letter-spacing: -0.025em;
			font-weight: 650;
			color: var(--sl-color-white);
			text-wrap: balance;
		}
		.tagline {
			font-size: clamp(var(--sl-text-base), calc(0.5rem + 1.2vw), var(--sl-text-xl));
			line-height: 1.5;
			color: var(--sl-color-gray-2);
			max-width: 38rem;
			text-wrap: pretty;
		}
		.actions {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.75rem 1.25rem;
			margin-top: 0.5rem;
		}
		.shot {
			width: 100%;
		}
		.shot img {
			width: 100%;
			height: auto;
			border-radius: 0.875rem;
			border: 1px solid var(--sl-color-hairline-light);
			box-shadow:
				0 1px 2px rgb(0 0 0 / 0.08),
				0 24px 64px -24px rgb(0 0 0 / 0.35);
		}
	}
</style>
