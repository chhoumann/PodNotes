---
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { withScreenshots } from "../screenshots.mjs";
import { withStackedTables } from "../tables.mjs";

// Short inline code, such as `12: Interview`, never splits across two lines.
const withShortCode = (html: string) =>
	html.replace(/<code dir="auto">(?=[^<]{1,24}<\/code>)/g, '<code dir="auto" class="short">');

const html = withShortCode(
	withStackedTables(await withScreenshots(await Astro.slots.render("default"))),
);
---

<Default><Fragment set:html={html} /></Default>
