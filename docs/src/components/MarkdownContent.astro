---
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { withScreenshots } from "../screenshots.mjs";
import { withStackedTables } from "../tables.mjs";
import { withVideos } from "../videos.mjs";

// Short inline code, such as `12: Interview`, never splits across two lines.
const withShortCode = (html: string) =>
	html.replace(/<code dir="auto">(?=[^<]{1,24}<\/code>)/g, '<code dir="auto" class="short">');

// Longer inline code, such as a path or a URL, may break after a slash, so it
// wraps in whole pieces.
const withPathBreaks = (html: string) =>
	html.replace(
		/<code dir="auto">([^<]*)<\/code>/g,
		(code, text: string) => `<code dir="auto">${text.replace(/\/+/g, "$&<wbr>")}</code>`,
	);

const html = withPathBreaks(
	withShortCode(
		withStackedTables(
			await withVideos(await withScreenshots(await Astro.slots.render("default"))),
		),
	),
);
const hasClips = html.includes('<video class="clip');
---

<Default><Fragment set:html={html} /></Default>
{
	hasClips && (
		<script is:inline>
			// Clips play on a loop for readers who allow motion. Readers who prefer
			// reduced motion get the poster and the controls. Only the clip that the
			// theme shows loads, so its twin for the other theme never downloads.
			{
				const still = matchMedia("(prefers-reduced-motion: reduce)");
				const clips = document.querySelectorAll("video.clip");
				const sync = () => {
					for (const clip of clips) {
						const shown = clip.getClientRects().length > 0;
						clip.controls = still.matches;
						if (!shown || still.matches) clip.pause();
						else clip.play().catch(() => (clip.controls = true));
					}
				};
				sync();
				still.addEventListener("change", sync);
				new MutationObserver(sync).observe(document.documentElement, {
					attributeFilter: ["data-theme"],
				});
			}
		</script>
	)
}
